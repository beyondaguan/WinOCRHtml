{
  "manifest_version": 3,
  "name": "WinOCR-Html",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "description": "v2 侧栏版：常驻翻译 + 截图 OCR + AI 对话 + 历史/生词/导出（翻译走 SiliconFlow）",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "activeTab",
    "tabs",
    "scripting",
    "nativeMessaging",
    "sidePanel",
    "audioCapture",
    "microphone",
    "downloads"
  ],
  "host_permissions": [
    "https://api.siliconflow.cn/*",
    "https://api.mymemory.translated.net/*",
    "https://*.siliconflow.cn/*",
    "https://cdnjs.cloudflare.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "WinOCR-Html（点击开/关侧栏）",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/common.js",
        "js/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel_v2.html"
  },
  "options_page": "options.html",
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "打开 WinOCR 侧栏"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "翻译当前选中"
    }
  },
  "key": ""
}
